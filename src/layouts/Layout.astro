---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Cristian Echeverry — Full-Stack Developer',
	description = 'Portafolio de Cristian Echeverry: desarrollo full-stack, experiencias web 3D, IA, automatización y productos digitales.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#080b12" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html,
	body {
		width: 100%;
		min-height: 100%;
		overflow-x: clip;
	}

	body {
		min-height: 100vh;
		background: #0a0a0a;
		color: #00ff00;
	}

	html {
		scroll-behavior: smooth;
	}

	::-webkit-scrollbar {
		width: 12px;
	}

	::-webkit-scrollbar-track {
		background: #0a0a0a;
		border-left: 2px solid #049393;
	}

	::-webkit-scrollbar-thumb {
		background: #03959a;
		border: 2px solid #0a0a0a;
	}

	::-webkit-scrollbar-thumb:hover {
		background: #00ffff;
	}

	* {
		scrollbar-width: thin;
		scrollbar-color: #00ff00 #0a0a0a;
	}
</style>
