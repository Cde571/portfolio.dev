---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description}>
  <div class="writing-shell">
    <div class="writing-grid" aria-hidden="true"></div>
    <div class="writing-glow writing-glow-a" aria-hidden="true"></div>
    <div class="writing-glow writing-glow-b" aria-hidden="true"></div>

    <header class="writing-nav">
      <div class="writing-nav-inner">
        <a class="writing-brand" href="/" aria-label="Volver al portfolio">
          <span>Cde57</span><small>/ BITÁCORA</small>
        </a>
        <nav aria-label="Navegación de escritos">
          <a href="/">Portfolio</a>
          <a href="/escritos" class="is-active">Escritos</a>
          <a href="/#projects">Proyectos</a>
          <a href="/#contact">Contacto</a>
        </nav>
        <a class="writing-github" href="https://github.com/Cde571" target="_blank" rel="noreferrer" aria-label="GitHub de Cde571">
          <i data-feather="github" aria-hidden="true"></i>
        </a>
      </div>
    </header>

    <slot />

    <footer class="writing-footer">
      <span>© 2026 CDE571</span>
      <span>APRENDER · CONSTRUIR · DOCUMENTAR</span>
      <a href="/escritos">Todos los escritos →</a>
    </footer>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/feather-icons/4.29.2/feather.min.js"></script>
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      if (window.feather) window.feather.replace({ 'stroke-width': 2, width: 18, height: 18 });
    });
  </script>
</Layout>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap");

  :root {
    --journal-bg: #080b12;
    --journal-surface: rgba(16, 22, 34, 0.78);
    --journal-surface-strong: #111827;
    --journal-text: #f7fbff;
    --journal-muted: #91a0b8;
    --journal-line: rgba(125, 150, 190, 0.2);
    --journal-cyan: #00f5ff;
    --journal-pink: #ff2bd6;
    --journal-lime: #8cff00;
    --journal-pixel: "Press Start 2P", monospace;
    --journal-mono: "JetBrains Mono", monospace;
    --journal-sans: "Inter", system-ui, sans-serif;
  }

  body { background: var(--journal-bg); color: var(--journal-text); }

  .writing-shell {
    min-height: 100vh;
    position: relative;
    overflow: clip;
    background:
      radial-gradient(circle at 12% 8%, rgba(0, 245, 255, 0.1), transparent 28rem),
      radial-gradient(circle at 88% 38%, rgba(255, 43, 214, 0.08), transparent 30rem),
      var(--journal-bg);
    color: var(--journal-text);
    font-family: var(--journal-sans);
  }

  .writing-grid {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0.32;
    background-image:
      linear-gradient(rgba(95, 130, 180, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(95, 130, 180, 0.055) 1px, transparent 1px);
    background-size: 38px 38px;
    mask-image: linear-gradient(to bottom, black, transparent 84%);
  }

  .writing-glow {
    position: fixed;
    z-index: 0;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    opacity: 0.1;
  }

  .writing-glow-a { left: -80px; top: 20%; background: var(--journal-cyan); }
  .writing-glow-b { right: -100px; top: 64%; background: var(--journal-pink); }

  .writing-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--journal-line);
    background: rgba(8, 11, 18, 0.9);
  }

  .writing-nav-inner {
    width: min(1180px, calc(100% - 2rem));
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .writing-brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    color: var(--journal-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .writing-brand span { font: 700 1.05rem/1 var(--journal-mono); font-style: italic; }
  .writing-brand small { color: var(--journal-cyan); font: 400 0.56rem/1 var(--journal-pixel); letter-spacing: 0.06em; }

  .writing-nav nav {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .writing-nav nav a {
    position: relative;
    color: var(--journal-muted);
    text-decoration: none;
    font: 600 0.78rem/1 var(--journal-mono);
    transition: color 160ms ease;
  }

  .writing-nav nav a:hover,
  .writing-nav nav a.is-active { color: var(--journal-text); }

  .writing-nav nav a.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -25px;
    height: 2px;
    background: var(--journal-cyan);
    box-shadow: 0 0 14px rgba(0, 245, 255, 0.8);
  }

  .writing-github {
    width: 38px;
    height: 38px;
    border: 1px solid var(--journal-line);
    border-radius: 10px;
    display: grid;
    place-items: center;
    color: var(--journal-muted);
    transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .writing-github:hover { color: var(--journal-cyan); border-color: rgba(0,245,255,.5); transform: translateY(-2px); }

  .writing-footer {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 2rem));
    margin: 5rem auto 0;
    padding: 1.5rem 0 2rem;
    border-top: 1px solid var(--journal-line);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--journal-muted);
    font: 500 0.68rem/1.5 var(--journal-mono);
    letter-spacing: 0.06em;
  }

  .writing-footer a { color: var(--journal-cyan); text-decoration: none; }

  @media (max-width: 720px) {
    .writing-nav-inner { min-height: auto; padding: 0.8rem 0; flex-wrap: wrap; gap: 0.7rem; }
    .writing-nav nav { order: 3; width: 100%; overflow-x: auto; gap: 0.45rem; padding-bottom: 0.1rem; scrollbar-width: none; }
    .writing-nav nav::-webkit-scrollbar { display: none; }
    .writing-nav nav a { flex: 0 0 auto; padding: 0.5rem 0.65rem; border: 1px solid var(--journal-line); border-radius: 999px; font-size: 0.68rem; }
    .writing-nav nav a.is-active { border-color: rgba(0,245,255,.48); background: rgba(0,245,255,.08); }
    .writing-nav nav a.is-active::after { display: none; }
    .writing-github { margin-left: auto; }
    .writing-footer { flex-direction: column; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
  }
</style>
