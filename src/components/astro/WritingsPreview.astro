---
import { writings } from '../../data/writings';

const previewWritings = writings.slice(0, 3);
---

<section class="writings-preview" id="writings" aria-labelledby="writings-title">
  <div class="writings-preview-inner" data-reveal>
    <div class="writings-preview-head">
      <div>
        <span class="writings-kicker">LAB NOTES / CDE571</span>
        <h2 id="writings-title">BITÁCORA DE INGENIERÍA</h2>
        <p>Estudios, decisiones técnicas y aprendizajes detrás de los proyectos.</p>
      </div>
      <a href="/escritos" class="writings-all-link">Ver todos los escritos <i data-feather="arrow-up-right" aria-hidden="true"></i></a>
    </div>

    <div class="writings-preview-grid">
      {previewWritings.map((writing, index) => (
        <article class="writing-preview-card" style={`--writing-accent:${writing.accent}`}>
          <div class="writing-preview-top">
            <span class="writing-number">LOG_{String(index + 1).padStart(2, '0')}</span>
            <span class="writing-status">{writing.status}</span>
          </div>
          <div class="writing-category">{writing.category} · {writing.readingMinutes} MIN</div>
          <h3>{writing.title}</h3>
          <p>{writing.excerpt}</p>
          <div class="writing-preview-tags">
            {writing.tags.slice(0, 3).map((tag) => <span>{tag}</span>)}
          </div>
          <a href={`/escritos/${writing.slug}`}>Leer borrador <i data-feather="arrow-right" aria-hidden="true"></i></a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .writings-preview {
    position: relative;
    z-index: 1;
    padding: 6.5rem 2rem;
    background:
      linear-gradient(180deg, transparent, rgba(0,245,255,.025) 40%, transparent),
      repeating-linear-gradient(90deg, transparent 0, transparent 59px, rgba(100,140,180,.045) 60px);
  }

  .writings-preview-inner { width: min(1400px, 100%); margin: 0 auto; }

  .writings-preview-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .writings-kicker {
    display: inline-block;
    margin-bottom: 0.8rem;
    color: #00f5ff;
    font-family: var(--font-mono, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
  }

  .writings-preview h2 {
    font-family: var(--font-pixel, monospace);
    font-size: clamp(1.45rem, 3vw, 2.65rem);
    line-height: 1.35;
    color: var(--text-primary, #fff);
  }

  .writings-preview-head p {
    max-width: 620px;
    margin-top: 0.8rem;
    color: var(--text-secondary, #a0a0a0);
    font-family: var(--font-sans, sans-serif);
    font-size: 1rem;
    line-height: 1.7;
  }

  .writings-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: 0 0 auto;
    color: #00f5ff;
    text-decoration: none;
    font: 600 0.78rem/1 var(--font-mono, monospace);
  }

  .writings-preview-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }

  .writing-preview-card {
    position: relative;
    min-height: 390px;
    padding: 1.25rem;
    border: 1px solid rgba(130,155,195,.22);
    border-top: 2px solid var(--writing-accent);
    border-radius: 18px;
    overflow: hidden;
    background: linear-gradient(145deg, rgba(19,27,42,.92), rgba(12,17,27,.84));
    box-shadow: 0 20px 60px rgba(0,0,0,.18);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .writing-preview-card::after {
    content: "";
    position: absolute;
    width: 150px;
    height: 150px;
    right: -70px;
    top: -70px;
    border-radius: 50%;
    background: var(--writing-accent);
    filter: blur(70px);
    opacity: .12;
    pointer-events: none;
  }

  .writing-preview-card:hover { transform: translateY(-6px); border-color: color-mix(in srgb, var(--writing-accent) 55%, transparent); box-shadow: 0 24px 70px rgba(0,0,0,.28), 0 0 30px color-mix(in srgb, var(--writing-accent) 12%, transparent); }
  .writing-preview-top { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .writing-number { color: var(--writing-accent); font: 600 .72rem/1 var(--font-mono, monospace); letter-spacing: .12em; }
  .writing-status { padding: .35rem .48rem; border: 1px solid rgba(245,158,11,.35); border-radius: 999px; color: #fbbf24; background: rgba(245,158,11,.08); font: 700 .55rem/1 var(--font-mono, monospace); text-transform: uppercase; }
  .writing-category { margin-top: 2.4rem; color: var(--writing-accent); font: 600 .65rem/1 var(--font-mono, monospace); letter-spacing: .1em; text-transform: uppercase; }
  .writing-preview-card h3 { margin-top: .9rem; color: var(--text-primary, #fff); font: 700 clamp(1.05rem, 1.8vw, 1.35rem)/1.45 var(--font-sans, sans-serif); }
  .writing-preview-card > p { margin-top: .85rem; color: var(--text-secondary, #a0a0a0); font: 400 .88rem/1.65 var(--font-sans, sans-serif); }
  .writing-preview-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin: 1.2rem 0 1.4rem; }
  .writing-preview-tags span { padding: .36rem .48rem; border: 1px solid rgba(130,155,195,.18); border-radius: 7px; color: var(--text-secondary, #a0a0a0); font: 500 .62rem/1 var(--font-mono, monospace); }
  .writing-preview-card > a { position: absolute; left: 1.25rem; bottom: 1.25rem; display: inline-flex; align-items: center; gap: .45rem; color: var(--writing-accent); text-decoration: none; font: 600 .74rem/1 var(--font-mono, monospace); }

  @media (max-width: 980px) { .writings-preview-grid { grid-template-columns: 1fr; } .writing-preview-card { min-height: 330px; } }
  @media (max-width: 680px) { .writings-preview { padding: 5rem 1rem; } .writings-preview-head { align-items: flex-start; flex-direction: column; } }
</style>
